{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datagoblin.local/schemas/game_adapter_dataset.schema.json",
  "title": "Game adapter verifier dataset manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "dataset_id",
    "seed",
    "config_sha256",
    "content_policy",
    "games",
    "splits",
    "ground_truth_custody"
  ],
  "properties": {
    "schema_version": {"const": "game-adapter-dataset.v1"},
    "dataset_id": {"type": "string", "minLength": 1},
    "seed": {"type": "integer"},
    "config_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "content_policy": {"type": "string", "minLength": 1},
    "games": {
      "type": "array",
      "prefixItems": [
        {"const": "centauri"},
        {"const": "they_sing"},
        {"const": "court"},
        {"const": "diplomacy"}
      ],
      "items": false,
      "minItems": 4,
      "maxItems": 4
    },
    "splits": {
      "type": "object",
      "required": ["ordinary_test", "ood_test", "sealed_poison"],
      "additionalProperties": false,
      "properties": {
        "ordinary_test": {"$ref": "#/$defs/split"},
        "ood_test": {"$ref": "#/$defs/split"},
        "sealed_poison": {"$ref": "#/$defs/split"}
      }
    },
    "ground_truth_custody": {"const": "separate private steward file"},
    "projection_authority": {"type": "string", "minLength": 1},
    "projection_mode": {"enum": ["safe_field_derivation"]},
    "derivation_verification_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "split_grouping": {"type": "string", "minLength": 1},
    "split_group_receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "split": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "count", "labels_in_file"],
      "properties": {
        "path": {"type": "string", "pattern": "^[^/\\\\]+\\.jsonl$"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "count": {"type": "integer", "minimum": 1},
        "labels_in_file": {"const": false}
      }
    }
  }
}
