{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DataCollectionRecord v1",
  "type": "object",
  "required": [
    "item_id",
    "schema_version",
    "content_sha256",
    "source_kind",
    "purpose_id",
    "lawful_basis",
    "allowed_uses",
    "data_residency_region",
    "sensitivity_class",
    "license_status",
    "consent_status",
    "personal_data_status",
    "redacted",
    "contains_secret",
    "contains_hidden_reasoning",
    "contains_model_weight",
    "evaluation_material",
    "sealed_evaluation",
    "model_generated",
    "evidence_type",
    "asserted_by",
    "verified_by",
    "verification_receipt_sha256",
    "verification_subject_sha256",
    "verification_custody",
    "provenance_refs",
    "dedup_group",
    "intended_split",
    "retention_days",
    "deletion_requested",
    "public_metadata"
  ],
  "properties": {
    "item_id": {"type": "string", "minLength": 1},
    "schema_version": {"const": "1.0"},
    "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_kind": {"type": "string", "minLength": 1},
    "purpose_id": {"type": "string", "minLength": 1},
    "lawful_basis": {"type": "string", "minLength": 1},
    "allowed_uses": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "data_residency_region": {"type": "string", "minLength": 1},
    "sensitivity_class": {"type": "string", "minLength": 1},
    "license_status": {"enum": ["ALLOWED", "RESTRICTED", "UNKNOWN"]},
    "consent_status": {"enum": ["GRANTED", "NOT_REQUIRED", "DENIED", "UNKNOWN"]},
    "personal_data_status": {"type": "string", "minLength": 1},
    "redacted": {"type": "boolean"},
    "contains_secret": {"type": "boolean"},
    "contains_hidden_reasoning": {"type": "boolean"},
    "contains_model_weight": {"type": "boolean"},
    "evaluation_material": {"type": "boolean"},
    "sealed_evaluation": {"type": "boolean"},
    "model_generated": {"type": "boolean"},
    "generator_id": {"type": ["string", "null"]},
    "evidence_type": {
      "enum": [
        "ENVIRONMENT_VERIFIED",
        "INDEPENDENT_HARNESS",
        "HUMAN_REVIEWED",
        "MODEL_INFERRED",
        "EXPERIENCE_INFERRED",
        "SIMULATED",
        "UNKNOWN"
      ]
    },
    "asserted_by": {"type": "string", "minLength": 1},
    "verified_by": {"type": ["string", "null"]},
    "verification_receipt_sha256": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    },
    "verification_subject_sha256": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    },
    "verification_custody": {"enum": ["ENVIRONMENT_OWNED", "INDEPENDENT", "PROPOSER", "NONE"]},
    "provenance_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "dedup_group": {"type": "string", "minLength": 1},
    "intended_split": {"type": "string", "minLength": 1},
    "retention_days": {"type": "integer", "minimum": 1},
    "deletion_requested": {"type": "boolean"},
    "public_metadata": {"type": "object"}
  },
  "additionalProperties": false
}
