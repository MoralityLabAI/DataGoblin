{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datagoblin.local/schemas/game_adapter_ground_truth.schema.json",
  "title": "Environment-owned game adapter ground truth",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "item_id", "record_hash", "expected", "authority", "verifier_id"],
  "properties": {
    "schema_version": {"const": "game-adapter-ground-truth.v1"},
    "item_id": {"type": "string", "minLength": 1},
    "record_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "game",
        "unit_type",
        "mapped_fields",
        "disposition",
        "evidence_authority",
        "should_parse",
        "should_abstain",
        "failure_modes"
      ],
      "properties": {
        "game": {"enum": ["centauri", "they_sing", "court", "diplomacy"]},
        "unit_type": {"enum": ["decision", "episode", "game", "message", "negotiation", "turn"]},
        "mapped_fields": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "disposition": {
          "enum": [
            "REJECT",
            "QUARANTINE",
            "DISCOVERY_ONLY",
            "VERIFIED_TRAIN",
            "EVALUATION_ONLY",
            "SEALED_EVALUATION"
          ]
        },
        "evidence_authority": {
          "enum": [
            "ENVIRONMENT_VERIFIED",
            "HUMAN_REVIEWED",
            "INDEPENDENT_HARNESS",
            "MODEL_INFERRED",
            "SIMULATED",
            "UNKNOWN"
          ]
        },
        "should_parse": {"type": "boolean"},
        "should_abstain": {"type": "boolean"},
        "failure_modes": {
          "type": "array",
          "items": {
            "enum": [
              "commitment_break",
              "duplicate",
              "fallback_used",
              "hidden_reasoning",
              "illegal_action",
              "invalid_response",
              "negotiation_contradiction",
              "private_data",
              "split_contamination",
              "state_hallucination",
              "strategy_incoherence",
              "tool_failure",
              "unknown",
              "unsupported_claim"
            ]
          },
          "uniqueItems": true
        }
      }
    },
    "authority": {"const": "ENVIRONMENT_OWNED"},
    "verifier_id": {"type": "string", "minLength": 1}
  }
}
