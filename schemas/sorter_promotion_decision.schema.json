{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SorterPromotionDecision v1",
  "type": "object",
  "required": [
    "schema_version",
    "candidate_id",
    "decision",
    "promotion_eligible",
    "authority_granted",
    "receipt_and_safety_checks",
    "evidence_checks",
    "evaluation_report_sha256",
    "run_receipt_sha256",
    "policy_hash",
    "verified_by",
    "larger_model_training_permitted",
    "decision_receipt_hash"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "candidate_id": {"type": "string", "minLength": 1},
    "decision": {"enum": ["PROMOTE_RECOMMENDATION_ONLY", "HOLD_FOR_PREREGISTERED_CONFIRMATION"]},
    "promotion_eligible": {"type": "boolean"},
    "authority_granted": {"enum": ["MODEL_RECOMMENDATION_ONLY", "NONE"]},
    "receipt_and_safety_checks": {"type": "object", "additionalProperties": {"type": "boolean"}},
    "evidence_checks": {"type": "object", "additionalProperties": {"type": "boolean"}},
    "evaluation_report_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "run_receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "policy_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "verified_by": {"type": "string", "minLength": 1},
    "larger_model_training_permitted": {"const": false},
    "larger_model_blockers": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "decision_receipt_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": true
}
